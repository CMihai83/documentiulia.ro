# DocumentIulia.ro - Production Environment Configuration
# Copy this file to .env.production and fill in the values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=documentiulia
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_DB=documentiulia
DATABASE_URL=postgresql://documentiulia:your_secure_database_password_here@postgres:5432/documentiulia?schema=public

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://documentiulia.ro
BACKEND_URL=https://api.documentiulia.ro

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_generate_with_openssl
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Clerk Authentication (if using Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# =============================================================================
# ANAF INTEGRATION (Romanian Tax Authority)
# =============================================================================
ANAF_API_URL=https://api.anaf.ro
ANAF_SPV_URL=https://www.anaf.ro/oauth
ANAF_CLIENT_ID=your_anaf_client_id
ANAF_CLIENT_SECRET=your_anaf_client_secret
# Path to SPV certificate for e-Factura
ANAF_CERTIFICATE_PATH=/app/certs/spv_certificate.p12
ANAF_CERTIFICATE_PASSWORD=your_certificate_password

# =============================================================================
# AI SERVICES
# =============================================================================
# Grok API (x.ai)
GROK_API_KEY=your_grok_api_key_here

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@documentiulia.ro
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=DocumentIulia <noreply@documentiulia.ro>

# =============================================================================
# FILE STORAGE
# =============================================================================
# Bunny.net CDN (recommended for production)
BUNNY_STORAGE_ZONE=documentiulia
BUNNY_API_KEY=your_bunny_api_key_here
BUNNY_CDN_URL=https://documentiulia.b-cdn.net

# Local storage fallback
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=50MB

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry Error Tracking
SENTRY_DSN=https://xxx@sentry.io/xxx

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
# SAGA Accounting Software
SAGA_API_URL=https://api.saga.ro
SAGA_CLIENT_ID=your_saga_client_id
SAGA_CLIENT_SECRET=your_saga_client_secret

# Stripe Payments
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# =============================================================================
# RATE LIMITING
# =============================================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=https://documentiulia.ro,https://www.documentiulia.ro

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_EFACTURA_B2B=true
FEATURE_SAFT_D406=true
FEATURE_AI_INSIGHTS=true
FEATURE_MOBILE_APP=true
