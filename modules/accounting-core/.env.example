# accounting-efactura standalone — copy to .env and fill in.
# DATABASE_URL / REDIS_* / ports are set by docker-compose; do not set them here.

# REQUIRED — standalone identity (never reuse the platform's secrets)
JWT_SECRET=change-me-standalone-accounting
JWT_REFRESH_SECRET=change-me-standalone-accounting-refresh
DB_PASSWORD=accounting

# CORS for the consuming frontend(s)
CORS_ORIGINS=http://localhost:3000


# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
