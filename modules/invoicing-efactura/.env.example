# invoicing-efactura standalone — copy to .env and fill in.
# DATABASE_URL / REDIS_* / ports are set by docker-compose; do not set them here.

# REQUIRED — standalone identity (never reuse the platform's secrets).
# REQ-048: the API refuses to start if these are missing, shorter than 16
# chars, or still a 'change-me' placeholder. Generate with:
#   openssl rand -hex 24
JWT_SECRET=change-me-standalone-invoicing
JWT_REFRESH_SECRET=change-me-standalone-invoicing-refresh
DB_PASSWORD=invoicing

# CORS for the consuming frontend(s)
CORS_ORIGINS=http://localhost:3000

# ANAF / e-Factura (same variables as the platform; per-customer in standalone mode)
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
ANAF_API_URL=https://api.anaf.ro
ANAF_SPV_URL=
ANAF_CERTIFICATE_PATH=
ANAF_CERTIFICATE_PASSWORD=

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
